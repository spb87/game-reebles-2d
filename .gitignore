art/staging/
__pycache__/
*.pyc

# OS noise
.DS_Store
Thumbs.db

# Environment / secrets / machine-local config
.env
.env.local
.devin/mcp_config.local.json

# Build / batch verification logs
unity-*.log
*.log

# Unity test results
*-results.xml
*_results.xml
em.xml
pm.xml
game/TestResults/
testresults/
PerformanceTestRun*.json

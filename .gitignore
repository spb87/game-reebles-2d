game/Library/
game/Temp/
game/Obj/
game/Build/
game/Builds/
game/Logs/
game/UserSettings/
game/MemoryCaptures/
game/Assets/AssetStoreTools*

# Visual Studio / IDE generated files
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
